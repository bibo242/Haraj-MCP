# --- Haraj auth (expires every ~10 days) ---
# 1. Log in to https://haraj.com.sa in Chrome.
# 2. F12 > Network, click any graphql.haraj.com.sa request.
# 3. Copy `authorization` (Bearer eyJ...) and `lastRequestId` headers below.
HARAJ_JWT=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9....paste_full_bearer_token....
LAST_REQUEST_ID=0000000000:00000:0000000000000000000000000

# --- Optional overrides ---
# HARAJ_MCP_ENV=/custom/path/to/.env        # if your .env lives elsewhere
# HARAJ_MCP_LOG_LEVEL=INFO                  # DEBUG for verbose logs